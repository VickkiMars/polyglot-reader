    {
      "id": "story_1856_p0_c1",
      "chunk_index": 1,
      "paragraph_index": 0,
      "sentence_index": 1,
      "text": "Бу́дь осторо́жна!",
      "text_en": "Be careful!",
      "ruby": "<ruby class=\"mb-tooltip\" data-py=\"Búd&#x27;\" data-defn=\"будь\" data-hsk=\"A2\"><span class=\"si\">Бу́дь</span><rt>Búd&#x27;</rt></ruby> <ruby class=\"mb-tooltip\" data-py=\"ostorózhna\" data-defn=\"осторожна\" data-hsk=\"A2\"><span class=\"si\">осторо́жна</span><rt>ostorózhna</rt></ruby>!",
      "transliteration": "Búd' ostorózhna!",

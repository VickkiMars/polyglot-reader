dinal number)\" data-hsk=\"HSK 1\"><span class=\"si\">第</span><span class=\"tr\">第</span><rt>dì</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"yī\" data-defn=\"one / single / a (article)\" data-hsk=\"HSK 1\"><span class=\"si\">一</span><span class=\"tr\">一</span><rt>yī</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"tiān\" data-defn=\"day\" data-hsk=\"HSK 1\"><span class=\"si\">天</span><span class=\"tr\">天</span><rt>tiān</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"shàng\" data-defn=\"to attend (class or university)\" data-hsk=\"HSK 1\"><span class=\"si\">上</span><span class=\"tr\">上</span><rt>shàng</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"xué\" data-defn=\"to learn / to study / to imitate\" data-hsk=\"HSK 1\"><span class=\"si\">学</span><span class=\"tr\">學</span><rt>xué</rt></ruby>，<ruby class=\"mb-tooltip\" data-py=\"lǎo shī\" data-defn=\"teacher\" data-hsk=\"HSK 1\"><span class=\"si\">老师</span><span class=\"tr\">老師</span><rt>lǎo shī</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"yòng\" data-defn=\"to use; to make use of; to employ / (coverb) with; using\" data-hsk=\"HSK 3\"><span class=\"si\">用</span><span class=\"tr\">用</span><rt>yòng</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"bǐ\" data-defn=\"writing brush; writing implement / brushstroke; stroke (in painting or calligraphy) / (bound form) style of writing; literary manner; technique of brushwork\" data-hsk=\"HSK 2(5)\"><span class=\"si\">笔</span><span class=\"tr\">筆</span><rt>bǐ</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"zài\" data-defn=\"(of sb or sth) to be (located) at\" data-hsk=\"HSK 1\"><span class=\"si\">在</span><span class=\"tr\">在</span><rt>zài</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"zhǐ\" data-defn=\"paper\" data-hsk=\"HSK 3\"><span class=\"si\">纸</span><span class=\"tr\">紙</span><rt>zhǐ</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"shàng\" data-defn=\"to attend (class or university)\" data-hsk=\"HSK 1\"><span class=\"si\">上</span><span class=\"tr\">上</span><rt>shàng</r
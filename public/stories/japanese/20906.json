  "english_paragraphs": [
    "I'm shopping for clothes at the mall. The red one looks nice, but it's very expensive. The black one is a little cheaper, but I don't like the color. Both are the right size. Which one should I buy?"
  ],
  "english_full": "I'm shopping for clothes at the mall. The red one looks nice, but it's very expensive. The black one is a little cheaper, but I don't like the color. Both are the right size. Which one should I buy?",
  "japanese_paragraphs": [
    "私はショッピングモールで衣服を買い物しています。赤い服はきれいに見えますが、とても高価です。黒い服は少し安いですが、その色は好きではありません。どちらもちょうど良いサイズです。どちらを買うべきでしょうか？"
  ],
  "reading_paragraphs": [

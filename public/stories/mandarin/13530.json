-hsk=\"HSK 1\"><span class=\"si\">年</span><span class=\"tr\">年</span><rt>nián</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"méi yǒu\" data-defn=\"haven&#x27;t / hasn&#x27;t\" data-hsk=\"HSK 1\"><span class=\"si\">没有</span><span class=\"tr\">沒有</span><rt>méi yǒu</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"jiàn miàn\" data-defn=\"to meet; to see each other\" data-hsk=\"HSK 3\"><span class=\"si\">见面</span><span class=\"tr\">見面</span><rt>jiàn miàn</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"le\" data-defn=\"(completed action marker) / (modal particle indicating change of state, situation now)\" data-hsk=\"HSK 1\"><span class=\"si\">了</span><span class=\"tr\">了</span><rt>le</rt></ruby>。<ruby class=\"mb-tooltip\" data-py=\"tā\" data-defn=\"he; him; his\" data-hsk=\"HSK 1\"><span class=\"si\">他</span><span class=\"tr\">他</span><rt>tā</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"zài\" data-defn=\"(of sb or sth) to be (located) at\" data-hsk=\"HSK 1\"><span class=\"si\">在</span><span class=\"tr\">在</span><rt>zài</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"yóu jiàn\" data-defn=\"mail / post / email\" data-hsk=\"HSK 3\"><span class=\"si\">邮件</span><span class=\"tr\">郵件</span><rt>yóu jiàn</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"zhōng\" data-defn=\"within; among; in\" data-hsk=\"HSK 3\"><span class=\"si\">中</span><span class=\"tr\">中</span><rt>zhōng</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"gào su\" data-defn=\"to tell; to inform; to let know\" data-hsk=\"HSK 2\"><span class=\"si\">告诉</span><span class=\"tr\">告訴</span><rt>gào su</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"wǒ\" data-defn=\"I; me; my\" data-hsk=\"HSK 1\"><span class=\"si\">我</span><span class=\"tr\">我</span><rt>wǒ</rt></ruby>，<ruby class=\"mb-tooltip\" data-py=\"xià\" data-defn=\"later / next (week etc)\" data-hsk=\"HSK 1\"><span class=\"si\">下</span><span class=\"tr\">下</span><rt>xià</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"gè\" data-defn=\"classifier for people or object
  "english_paragraphs": [
    "Mom: What’s wrong?",
    "Child: Mom, I’m tired… and I’m really thirsty, too.",
    "Mom: Sit here. How do you feel now?",
    "Child: A little better.",
    "Mom: Look! There’s some cola over there! I’ll go buy some.",
    "Mom: Here, have a drink!",
    "Child: Thanks, Mom. It tastes great.",
    "Mom: Do you feel better now?",
    "Child: Yes, I feel better now. Thanks, Mom!"
  ],
  "english_full": "Mom: What’s wrong?\n\nChild: Mom, I’m tired… and I’m really thirsty, too.\n\nMom: Sit here. How do you feel now?\n\nChild: A little better.\n\nMom: Look! There’s some cola over there! I’ll go buy some.\n\nMom: Here, have a drink!\n\nChild: Thanks, Mom. It tastes great.\n\nMom: Do you feel better now?\n\nChild: Yes, I feel better now. Thanks, Mom!",
  "japanese_paragraphs": [
    "ママ：どうしたの？",
    "子供：ママ、疲れた…それに、のどが渇いたよ。",
    "ママ：ここに座って。今はどう感じる？",
    "子供：少し良くなった。",
    "ママ：見て！あそこにコーラがあるよ！買ってくるね。",
    "ママ：はい、飲みなさい！",
    "子供：ありがとう、ママ。とても美味しい。",
    "ママ：今は気分が良くなった？",
    "子供：うん、今は良くなったよ。ありがとう、ママ！"
  ],
  "reading_paragraphs": [
    "まま：どうしたの？",
    "こども：まま、つかれた…それに、のどがかわいたよ。",
    "まま：ここにすわって。いまはどうかんじる？",
    "こども：すこしよくなった。",
    "まま：みて！あそこにこーらがあるよ！かってくるね。",
    "まま：はい、のみなさい！",
    "こども：ありがとう、まま。とてもおいしい。",
    "まま：いまはきぶんがよくなった？",
    "こども：うん、いまはよくなったよ。ありがとう、まま！"
  ],

tooltip\" data-py=\"bù\" data-defn=\"no; not so\" data-hsk=\"HSK 1\"><span class=\"si\">不</span><span class=\"tr\">不</span><rt>bù</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"shì\" data-defn=\"to be (followed by substantives only)\" data-hsk=\"HSK 1\"><span class=\"si\">是</span><span class=\"tr\">是</span><rt>shì</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"lín jū\" data-defn=\"neighbor\" data-hsk=\"HSK 3\"><span class=\"si\">邻居</span><span class=\"tr\">鄰居</span><rt>lín jū</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"de\" data-defn=\"possessive particle (of; &#x27;s) / modifying particle (used after an attribute to modify a noun or to form a nominal expression)\" data-hsk=\"HSK 1\"><span class=\"si\">的</span><span class=\"tr\">的</span><rt>de</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"yī fu\" data-defn=\"clothes\" data-hsk=\"HSK 1\"><span class=\"si\">衣服</span><span class=\"tr\">衣服</span><rt>yī fu</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"méi\" data-defn=\"(negative prefix for verbs) have not; not\" data-hsk=\"HSK 1\"><span class=\"si\">没</span><span class=\"tr\">沒</span><rt>méi</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"xǐ\" data-defn=\"to wash; to bathe / to develop (photographs) / to shuffle (cards etc) / to erase (a recording)\" data-hsk=\"HSK 2\"><span class=\"si\">洗</span><span class=\"tr\">洗</span><rt>xǐ</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"gān jìng\" data-defn=\"clean / neat\" data-hsk=\"HSK 3\"><span class=\"si\">干净</span><span class=\"tr\">乾淨</span><rt>gān jìng</rt></ruby>，<ruby class=\"mb-tooltip\" data-py=\"ér\" data-defn=\"but (not) / yet (not) / (indicates contrast)\" data-hsk=\"HSK 4\"><span class=\"si\">而</span><span class=\"tr\">而</span><rt>ér</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"shì\" data-defn=\"to be (followed by substantives only)\" data-hsk=\"HSK 1\"><span class=\"si\">是</span><span class=\"tr\">是</span><rt>shì</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"tā\" data-defn=\"she\" data-hsk=\"HSK 1\">
    },
    {
      "id": "story_20647_p1_c0",
      "chunk_index": 2,
      "paragraph_index": 1,
      "sentence_index": 0,
      "text": "Ли Ми́н о́чень высо́кий и то́лстый.",
      "text_en": "Li Ming is very tall and fat.",

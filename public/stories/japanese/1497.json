    {
      "id": "story_1497_p0_c0",
      "chunk_index": 0,
      "paragraph_index": 0,
      "sentence_index": 0,
      "text": "私は1992年2月29日に生まれました。",
      "text_en": "I was born on February 29, 1992, so that’s my birthday.",
      "ruby": "<ruby class=\"mb-tooltip\" data-py=\"わたし\" data-defn=\"わたし (word)\" data-hsk=\"JLPT N5\"><span class=\"si\">私</span><rt>わたし</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"は\" data-defn=\"topic marker\" data-hsk=\"JLPT N5\"><span class=\"si\">は</span><rt></rt></ruby><ruby class=\"mb-tooltip\" data-py=\"1992\" data-defn=\"1992年 (number / counter)\" data-hsk=\"\"><span class=\"si\">1992年</span><rt>1992</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"2\" data-defn=\"2月 (number / counter)\" data-hsk=\"\"><span class=\"si\">2月</span><rt>2</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"29\" data-defn=\"29日 (number / counter)\" data-hsk=\"\"><span class=\"si\">29日</span><rt>29</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"に\" data-defn=\"target / time / direction marker (to/at/in)\" data-hsk=\"JLPT N5\"><span class=\"si\">に</span><rt></rt></ruby><ruby class=\"mb-tooltip\" data-py=\"うまれ\" data-defn=\"to be born (生まれる)\" data-hsk=\"JLPT N5\"><span class=\"si\">生まれ</span><rt>うまれ</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"ました\" data-defn=\"verb polite suffix (past: did / -ed)\" data-hsk=\"JLPT N5\"><span class=\"si\">ました</span><rt></rt></ruby>。",
      "start": 0.0,
      "end": 5.65,
      "duration": 5.65
    },
    {
      "id": "story_1497_p0_c1",
      "chunk_index": 1,
      "paragraph_index": 0,
      "sentence_index": 1,
      "text": "だから、それが私の誕生日です。",
      "text_en": "I don’t like this date because it’s so unusual.",
      "ruby": "<ruby class=\"mb-tooltip\" data-py=\"だから\" data-defn=\"だから (word)\" data-hsk=\"\"><span class=\"si\">だから</span><rt></rt></ruby>、<ruby class=\"mb-tooltip\" data-py=\"それ\" data-defn=\"that/it; then/that point (in time)/that time\" data-hsk=\"\"><span class=\"si\">それ</span><rt></rt></ruby><ruby class=\"mb-tooltip\" data-py=\"が\" data-defn=\"subject marker\" data-hsk=\"JLPT N5\"><span class=\"si\">が</span><rt></rt></ruby><ruby class=\"mb-tooltip\" data-py=\"わたし\" data-defn=\"わたし (word)\" data-hsk=\"JLPT N5\"><span class=\"si\">私</span><rt>わたし</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"の\" data-defn=\"possessive particle (&#x27;s / of)\" data-hsk=\"JLPT N5\"><span class=\"si\">の</span><rt></rt></ruby><ruby class=\"mb-tooltip\" data-py=\"たんじょう\" data-defn=\"たんじょう (word)\" data-hsk=\"\"><span class=\"si\">誕生</span><rt>たんじょう</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"にち\" data-defn=\"day / date\" data-hsk=\"JLPT N5\"><span class=\"si\">日</span><rt>にち</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"です\" data-defn=\"be / is / are (polite copula)\" data-hsk=\"JLPT N5\"><span class=\"si\">です</span><rt></rt></ruby>。",
      "start": 6.0,
      "end": 9.52,
      "duration": 3.52
    },

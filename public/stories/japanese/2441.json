      "start": 0.0,
      "end": 6.42,
      "duration": 6.42
    },
    {
      "id": "story_2441_p0_c1",
      "chunk_index": 1,
      "paragraph_index": 0,
      "sentence_index": 1,
      "text": "喜んで、彼はその卵を家に持って帰りました。",
      "text_en": "Delighted, he took the egg home.",
      "ruby": "<ruby class=\"mb-tooltip\" data-py=\"よろこん\" data-defn=\"to be delighted/to be glad/to be pleased; to congratulate (喜ぶ)\" data-hsk=\"JLPT N5\"><span class=\"si\">喜ん</span><rt>よろこん</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"で\" data-defn=\"location / means marker (at/in/by)\" data-hsk=\"JLPT N5\"><span class=\"si\">で</span><rt></rt></ruby>、<ruby class=\"mb-tooltip\" data-py=\"かれ\" data-defn=\"that/that thing; that person\" data-hsk=\"\"><span class=\"si\">彼</span><rt>かれ</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"は\" data-defn=\"topic marker\" data-hsk=\"JLPT N5\"><span class=\"si\">は</span><rt></rt></ruby><ruby class=\"mb-tooltip\" data-py=\"その\" data-defn=\"that/the; part (as in &quot;part two&quot;)\" data-hsk=\"\"><span class=\"si\">その</span><rt></rt></ruby><ruby class=\"mb-tooltip\" data-py=\"たまご\" data-defn=\"たまご (word)\" data-hsk=\"\"><span class=\"si\">卵</span><rt>たまご</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"を\" data-defn=\"direct object marker\" data-hsk=\"JLPT N5\"><span class=\"si\">を</span><rt></rt></ruby><ruby class=\"mb-tooltip\" data-py=\"いえ\" data-defn=\"いえ (word)\" data-hsk=\"JLPT N5\"><span class=\"si\">家</span><rt>いえ</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"に\" data-defn=\"target / time / direction marker (to/at/in)\" data-hsk=\"JLPT N5\"><span class=\"si\">に</span><rt></rt></ruby><ruby class=\"mb-tooltip\" data-py=\"もっ\" data-defn=\"to hold (in one&#x27;s hand)/to take/to carry; to possess/to have/to own (持つ)\" data-hsk=\"JLPT N5\"><span class=\"si\">持っ</span><rt>もっ</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"て\" data-defn=\"conjunctive particle (and / -ing)\" data-hsk=\"JLPT N5\"><span class=\"si\">て</span><rt></rt></ruby><ruby class=\"mb-tooltip\" data-py=\"かえり\" data-defn=\"to return/to come home/to go home/to go back; to leave (帰る)\" data-hsk=\"JLPT N5\"><span class=\"si\">帰り</span><rt>かえり</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"ました\" data-defn=\"verb polite suffix (past: did / -ed)\" data-hsk=\
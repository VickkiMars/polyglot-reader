a-py=\"hěn duō\" data-defn=\"many; a lot of\" data-hsk=\"\"><span class=\"si\">很多</span><span class=\"tr\">很多</span><rt>hěn duō</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"máng\" data-defn=\"blind\" data-hsk=\"\"><span class=\"si\">盲</span><span class=\"tr\">盲</span><rt>máng</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"rén\" data-defn=\"person; people\" data-hsk=\"HSK 1\"><span class=\"si\">人</span><span class=\"tr\">人</span><rt>rén</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"a\" data-defn=\"modal particle ending sentence, showing affirmation, approval, or consent\" data-hsk=\"HSK 3\"><span class=\"si\">啊</span><span class=\"tr\">啊</span><rt>a</rt></ruby>。", "<ruby class=\"mb-tooltip\" data-py=\"hòu lái\" data-defn=\"afterwards; later\" data-hsk=\"HSK 4\"><span class=\"si\">后来</span><span class=\"tr\">後來</span><rt>hòu lái</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"wǒ\" data-defn=\"I; me; my\" data-hsk=\"HSK 1\"><span class=\"si\">我</span><span class=\"tr\">我</span><rt>wǒ</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"kāi shǐ\" data-defn=\"to begin / to start\" data-hsk=\"HSK 2\"><span class=\"si\">开始</span><span class=\"tr\">開始</span><rt>kāi shǐ</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"xué xí\" data-defn=\"to learn / to study\" data-hsk=\"HSK 1\"><span class=\"si\">学习</span><span class=\"tr\">學習</span><rt>xué xí</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"yīn yuè\" data-defn=\"music\" data-hsk=\"HSK 3\"><span class=\"si\">音乐</span><span class=\"tr\">音樂</span><rt>yīn yuè</rt></ruby>，<ruby class=\"mb-tooltip\" data-py=\"wǒ\" data-defn=\"I; me; my\" data-hsk=\"HSK 1\"><span class=\"si\">我</span><span class=\"tr\">我</span><rt>wǒ</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"rèn wéi\" data-defn=\"to believe; to think; to consider; to feel\" data-hsk=\"HSK 3\"><span class=\"si\">认为</span><span class=\"tr\">認為</span><rt>rèn wéi</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"shēn tǐ\" data-defn=\"the body\" data-hsk=\"HSK 2\"><span class=\"si\
y class=\"mb-tooltip\" data-py=\"duō\" data-defn=\"too many; in excess\" data-hsk=\"HSK 1\"><span class=\"si\">多</span><span class=\"tr\">多</span><rt>duō</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"le\" data-defn=\"(completed action marker) / (modal particle indicating change of state, situation now)\" data-hsk=\"HSK 1\"><span class=\"si\">了</span><span class=\"tr\">了</span><rt>le</rt></ruby>，<ruby class=\"mb-tooltip\" data-py=\"tā\" data-defn=\"he; him; his\" data-hsk=\"HSK 1\"><span class=\"si\">他</span><span class=\"tr\">他</span><rt>tā</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"tài\" data-defn=\"too (much) / very / extremely\" data-hsk=\"HSK 1\"><span class=\"si\">太</span><span class=\"tr\">太</span><rt>tài</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"máng\" data-defn=\"busy\" data-hsk=\"HSK 2\"><span class=\"si\">忙</span><span class=\"tr\">忙</span><rt>máng</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"le\" data-defn=\"(completed action marker) / (modal particle indicating change of state, situation now)\" data-hsk=\"HSK 1\"><span class=\"si\">了</span><span class=\"tr\">了</span><rt>le</rt></ruby>。", "<ruby class=\"mb-tooltip\" data-py=\"tā\" data-defn=\"he; him; his\" data-hsk=\"HSK 1\"><span class=\"si\">他</span><span class=\"tr\">他</span><rt>tā</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"méi yǒu\" data-defn=\"haven&#x27;t / hasn&#x27;t\" data-hsk=\"HSK 1\"><span class=\"si\">没有</span><span class=\"tr\">沒有</span><rt>méi yǒu</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"wàng jì\" data-defn=\"to forget\" data-hsk=\"HSK 3\"><span class=\"si\">忘记</span><span class=\"tr\">忘記</span><rt>wàng jì</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"zì jǐ\" data-defn=\"oneself; (attributive) one&#x27;s own\" data-hsk=\"HSK 3\"><span class=\"si\">自己</span><span class=\"tr\">自己</span><rt>zì jǐ</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"hái\" data-defn=\"still, still in progress, yet\" data-hsk=\"HSK 2\"><span class=\"si\">还</span><span class=\"tr\">還</spa
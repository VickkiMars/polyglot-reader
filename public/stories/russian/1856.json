t></ruby> <ruby class=\"mb-tooltip\" data-py=\"vozhú\" data-defn=\"вожу\" data-hsk=\"A2\"><span class=\"si\">вожу́</span><rt>vozhú</rt></ruby> <ruby class=\"mb-tooltip\" data-py=\"avtómobíl&#x27;\" data-defn=\"автомобиль\" data-hsk=\"A2\"><span class=\"si\">авто́моби́ль</span><rt>avtómobíl&#x27;</rt></ruby>, <ruby class=\"mb-tooltip\" data-py=\"a\" data-defn=\"а\" data-hsk=\"A2\"><span class=\"si\">а</span><rt>a</rt></ruby> <ruby class=\"mb-tooltip\" data-py=\"ty\" data-defn=\"ты\" data-hsk=\"A2\"><span class=\"si\">ты</span><rt>ty</rt></ruby> <ruby class=\"mb-tooltip\" data-py=\"póstoyanno\" data-defn=\"постоянно\" data-hsk=\"A2\"><span class=\"si\">по́стоянно</span><rt>póstoyanno</rt></ruby> <ruby class=\"mb-tooltip\" data-py=\"govorísh&#x27;\" data-defn=\"говоришь\" data-hsk=\"A2\"><span class=\"si\">говори́шь</span><rt>govorísh&#x27;</rt></ruby> <ruby class=\"mb-tooltip\" data-py=\"ryadom\" data-defn=\"рядом\" data-hsk=\"A2\"><span class=\"si\">рядом</span><rt>ryadom</rt></ruby> <ruby class=\"mb-tooltip\" data-py=\"so\" data-defn=\"со\" data-hsk=\"A2\"><span class=\"si\">со</span><rt>so</rt></ruby> <ruby class=\"mb-tooltip\" data-py=\"mnoy\" data-defn=\"мной\" data-hsk=\"A2\"><span class=\"si\">мной</span><rt>mnoy</rt></ruby>...»",

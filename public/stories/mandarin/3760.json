a-defn=\"classifier for events, things, clothes etc\" data-hsk=\"HSK 2\"><span class=\"si\">件</span><span class=\"tr\">件</span><rt>jiàn</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"xiǎo\" data-defn=\"small / tiny / few\" data-hsk=\"HSK 1\"><span class=\"si\">小</span><span class=\"tr\">小</span><rt>xiǎo</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"shì\" data-defn=\"matter / thing / item / affair\" data-hsk=\"HSK 1\"><span class=\"si\">事</span><span class=\"tr\">事</span><rt>shì</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"rě\" data-defn=\"to provoke / to irritate / to vex / to stir up / to anger / to attract (troubles) / to cause (problems)\" data-hsk=\"HSK 7-9\"><span class=\"si\">惹</span><span class=\"tr\">惹</span><rt>rě</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"qī zi\" data-defn=\"wife\" data-hsk=\"HSK 2\"><span class=\"si\">妻子</span><span class=\"tr\">妻子</span><rt>qī zi</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"shēng qì\" data-defn=\"to get angry; to be furious\" data-hsk=\"HSK 3\"><span class=\"si\">生气</span><span class=\"tr\">生氣</span><rt>shēng qì</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"le\" data-defn=\"(completed action marker) / (modal particle indicating change of state, situation now)\" data-hsk=\"HSK 1\"><span class=\"si\">了</span><span class=\"tr\">了</span><rt>le</rt></ruby>，<ruby class=\"mb-tooltip\" data-py=\"qī zi\" data-defn=\"wife\" data-hsk=\"HSK 2\"><span class=\"si\">妻子</span><span class=\"tr\">妻子</span><rt>qī zi</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"jiù\" data-defn=\"in that case; then\" data-hsk=\"HSK 2\"><span class=\"si\">就</span><span class=\"tr\">就</span><rt>jiù</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"duì\" data-defn=\"classifier: couple; pair\" data-hsk=\"HSK 2\"><span class=\"si\">对</span><span class=\"tr\">對</span><rt>duì</rt></ruby><ruby class=\"mb-tooltip\" data-py=\"zhe\" data-defn=\"aspect particle indicating action in progress or ongoing state\" data-hsk=\"HSK 2\"><span class=\"si\">着</spa
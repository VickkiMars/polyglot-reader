    {
      "id": "story_4061_p2_c0",
      "chunk_index": 3,
      "paragraph_index": 2,
      "sentence_index": 0,
      "text": "Счастли́вая жизнь вызыва́ется счастливы́ми мыслями.",
      "text_en": "A happy life is caused by happy thoughts.",
      "ruby": "<ruby class=\"mb-tooltip\" data-py=\"Schastlívaya\" data-defn=\"счастливая\" data-hsk=\"A2\"><span class=\"si\">Счастли́вая</span><rt>Schastlívaya</rt></ruby> <ruby class=\"mb-tooltip\" data-py=\"zhizn&#x27;\" data-defn=\"жизнь\" data-hsk=\"A2\"><span class=\"si\">жизнь</span><rt>zhizn&#x27;</rt></ruby> <ruby class=\"mb-tooltip\" data-py=\"vyzyváetsya\" data-defn=\"вызывается\" data-hsk=\"A2\"><span class=\"si\">вызыва́ется</span><rt>vyzyváetsya</rt></ruby> <ruby class=\"mb-tooltip\" data-py=\"schastlivými\" data-defn=\"счастливыми\" data-hsk=\"A2\"><span class=\"si\">счастливы́ми</span><rt>schastlivými</rt></ruby> <ruby class=\"mb-tooltip\" data-py=\"myslyami\" data-defn=\"мыслями\" data-hsk=\"A2\"><span class=\"si\">мыслями</span><rt>myslyami</rt></ruby>.",

    {
      "id": "story_1592_p0_c1",
      "chunk_index": 1,
      "paragraph_index": 0,
      "sentence_index": 1,
      "text": "私はそれが本当であるはずがないと答えました。",
      "text_en": "I said that couldn’t be true—my boyfriend had told me he didn’t have time to eat yesterday.",

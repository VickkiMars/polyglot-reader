      "end": 27.35,
      "duration": 3.58
    },
    {
      "id": "story_1497_p0_c5",
      "chunk_index": 5,
      "paragraph_index": 0,
      "sentence_index": 5,
      "text": "そのような年は「うるう年」と呼ばれます。",
      "text_en": "You can celebrate your birthday every year, but I can only celebrate mine once every four years.",

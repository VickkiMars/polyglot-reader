  "english_paragraphs": [
    "Mom: What’s wrong?",
    "Child: Mom, I’m tired… and I’m really thirsty, too.",
    "Mom: Sit here. How do you feel now?",
    "Child: A little better.",
    "Mom: Look! There’s some cola over there! I’ll go buy some.",
    "Mom: Here, have a drink!",
    "Child: Thanks, Mom. It tastes great.",
    "Mom: Do you feel better now?",
    "Child: Yes, I feel better now. Thanks, Mom!"
  ],
  "english_full": "Mom: What’s wrong?\n\nChild: Mom, I’m tired… and I’m really thirsty, too.\n\nMom: Sit here. How do you feel now?\n\nChild: A little better.\n\nMom: Look! There’s some cola over there! I’ll go buy some.\n\nMom: Here, have a drink!\n\nChild: Thanks, Mom. It tastes great.\n\nMom: Do you feel better now?\n\nChild: Yes, I feel better now. Thanks, Mom!",
  "russian_paragraphs": [
    "Ма́ма: Что ты́? ",
    "Ребёнок: Ма́ма, я уста́лый... и я по́ действи́тельно жа́ждущий, то́же. ",
    "Ма́ма: Сиде́ть здесь. Как ты́ се́йча́с? ",
    "Ребёнок: Немно́го лу́чше. ",
    "Ма́ма: Смотри́! Вон там не́сколько ко́лы! Я пойду́ купи́ть. ",
    "Ма́ма: Держи́, попи́й! ",
    "Ребёнок: Спаси́бо, Ма́ма. Вкус отли́чный. ",
    "Ма́ма: Ты́ се́йча́с чувств́уешь себя́ лу́чше? ",
    "Ребёнок: Да, я чувств́ую себя́ лу́чше. Спаси́бо, Ма́ма!"
  ],
  "reading_paragraphs": [
    "Máma: Chto tý?",
    "Rebyónok: Máma, ya ustályy... i ya pó dēystvítel'no zházhdúshchiy, tózhe.",
    "Máma: Sidét' zdes'. Kak tý séychas?",
    "Rebyónok: Nemnógo luchshe.",
    "Máma: Smotrí! Von tam néskol'ko kóly! Ya poydú kupít'.",
    "Máma: Derzhí, popít'!",
    "Rebyónok: Spasíbó, Máma. Vkus otlíchnyy.",
    "Máma: Tý séychas chuvstvuésh' sebá luchshe?",
    "Rebyónok: Da, ya chuvstvúyush' sebá luchshe. Spasíbó, Máma!"
  ],
